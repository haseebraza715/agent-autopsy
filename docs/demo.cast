[26.630793, "o", "ly in A    \u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37m[8, 9, 10]                                        \u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mEvent IDs only in B    \u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37m[]                                                \u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mPatterns only in A     \u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mempty_response, error_cascade, infinite_loop,     \u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m                         \u001b[0m│\u001b[37m \u001b[0m\u001b[37mtimeout_pattern                                   \u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mPatterns only in B     \u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37mNone                                              \u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mNew tool signatures    \u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37m1                                                 \u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mRemoved tool signatures\u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37m0                                                 \u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mTool arg/name diffs    \u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37m1    "]

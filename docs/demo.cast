[11.392803, "o", "\u001b[1m\u001b[36m──────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1m\u001b[34m▸ Part 3 — generate a fix\u001b[0m\r\n"]
[11.392936, "o", "\u001b[1m\u001b[36m──────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[2mAutopsy turns findings into concrete, ready-to-apply code: a LoopGuard\u001b[0m\r\n\u001b[2mthat caps identical tool calls, and an error boundary for the cascade.\u001b[0m\r\n\r\n\u001b[1m\u001b[33m$ autopsy fixes examples/traces/loop_failure.json\u001b[0m\r\n\r\n"]
[18.092283, "o", "\u001b[34m╭─\u001b[0m\u001b[34m─────────────────────────────────────\u001b[0m\u001b[34m Fix Suggestion 1 \u001b[0m\u001b[34m──────────────────────────────────────\u001b[0m\u001b[34m─╮\u001b[0m\r\n\u001b[34m│\u001b[0m \u001b[1mAdd max-iteration guard to looping node\u001b[0m                                                       \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m Category: code                                                                                \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m Events: [3, 4, 5, 6, 7, 8, 9]                                                                 \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m                                                                                               \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m Rationale: Identical tool calls repeated consecutively indicate missing termination criteria. \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m                                                                                               \u001b["]
[18.093983, "o", "34m│\u001b[0m\r\n\u001b[34m│\u001b[0m Patch snippet:                                                                                \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m # candidate node: web_search                                                                  \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m state['iteration_count'] = state.get('iteration_count', 0) + 1                                \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m if state['iteration_count'] > MAX_ITERATIONS:                                                 \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m     raise RuntimeError('Loop guard triggered')                                                \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m                                                                                               \u001b[34m│\u001b[0m\r\n\u001b[34m╰────────────────────────────────────────────────────────────────────────────────────────────"]
[18.094221, "o", "───╯\u001b[0m\r\n"]
[18.094614, "o", "\u001b[34m╭─\u001b[0m\u001b[34m──────────────────────────────\u001b[0m\u001b[34m Fix Suggestion 2 \u001b[0m\u001b[34m──────────────────────────────\u001b[0m\u001b[34m─╮\u001b[0m\r\n\u001b[34m│\u001b[0m \u001b[1mWrap failing tool calls with local error boundary\u001b[0m                              \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m Category: code                                                                 \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m Events: [3, 4, 5, 6, 7, 8, 9, 10]                                              \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m                                                                                \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m Rationale: Error cascades indicate one failure propagates without containment. \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m                                                                                \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m Patch snippet:                                                                 \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m def "]
[18.094734, "o", "safe_web_search(**kwargs):                                                 \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m     try:                                                                       \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m         return web_search(**kwargs)                                            \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m     except Exception as exc:                                                   \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m         return {'ok': False, 'error': str(exc), 'retryable': False}            \u001b[34m│\u001b[0m\r\n\u001b[34m│\u001b[0m                                                                                \u001b[34m│\u001b[0m\r\n\u001b[34m╰────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[18.66805, "o", "\r\n"]
[18.672127, "o", "\u001b[2mThe same analysis can emit full patch artifacts:\u001b[0m\r\n"]
[18.67227, "o", "\u001b[1m\u001b[33m$ autopsy analyze examples/traces/loop_failure.json --no-llm --no-embeddings --artifacts <dir>\u001b[0m\r\n"]
[18.899391, "o", "\u001b[32m✓ artifacts written to /Users/x/Downloads/05 Code & Projects/Codex & Workspace/workspace/agent-autopsy/.demo-fixes.RwMglf: error_handler.py loop_guard.py manifest.json \u001b[0m\r\n"]
[18.899477, "o", "\r\n\u001b[1m\u001b[35mIt is real code — the generated LoopGuard:\u001b[0m\r\n\r\n"]
[18.903761, "o", "\"\"\"Loop detection and prevention guard.\"\"\"\r\n\r\nfrom collections import defaultdict\r\nfrom typing import Any, Callable\r\nimport hashlib\r\n\r\n\r\nclass LoopGuard:\r\n    \"\"\"Detects and prevents infinite loops in agent execution.\"\"\"\r\n\r\n    def __init__(self, max_repetitions: int = 3):\r\n        self.max_repetitions = max_repetitions\r\n        self.call_history: dict[str, int] = defaultdict(int)\r\n\r\n    def get_call_signature(self, tool_name: str, args: dict[str, Any]) -> str:\r\n        \"\"\"Generate a signature for a tool call.\"\"\"\r\n        args_str = str(sorted(args.items()))\r\n        return f\"{tool_name}:{hashlib.md5(args_str.encode()).hexdigest()}\"\r\n\r\n    def should_allow(self, tool_name: str, args: dict[str, Any]) -> bool:\r\n        \"\"\"Check if this call should be allowed.\"\"\"\r\n        signature = self.get_call_signature(tool_name, args)\r\n"]
[18.904024, "o", "\r\n"]
[19.512066, "o", "\u001b[1m\u001b[36m──────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1m\u001b[34m▸ Part 4 — diff the failing run against the fixed run\u001b[0m\r\n"]
[19.512168, "o", "\u001b[1m\u001b[36m──────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[2mSame goal. Before: the looping run. After: the same agent once the\u001b[0m\r\n\u001b[2mLoopGuard + timeout fix are in place. One command shows the delta.\u001b[0m\r\n\r\n\u001b[1m\u001b[33m$ autopsy diff examples/traces/loop_failure.json examples/traces/loop_fixed.json\u001b[0m\r\n\r\n"]

[27.877632, "o", "\u001b[1m\u001b[33m$ autopsy replay ./trace.json --step\u001b[0m\r\n"]
[27.878392, "o", "\u001b[1m\u001b[33m$ autopsy benchmark --traces-dir ./traces\u001b[0m\r\n\u001b[1m\u001b[36m──────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1m\u001b[35m✓ demo complete · Agent Autopsy ran fully offline\u001b[0m\r\n"]

# LLM provider: openrouter | openai | anthropic | ollama
PROVIDER=openrouter

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenAI / Anthropic when PROVIDER is openai or anthropic
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

DEFAULT_MODEL=xiaomi/mimo-v2-flash:free

FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free

LOG_LEVEL=INFO

EMBEDDING_MODEL=all-MiniLM-L6-v2

# Skip sentence-transformers entirely (CLI also supports --no-embeddings)
# AUTOPSY_NO_EMBEDDINGS=1

# MCP SSE / streamable-http bearer token (optional; stdio ignores this)
# MCP_SSE_TOKEN=replace-with-long-random-secret

# Trace Capture Configuration
TRACE_ENABLED=1
TRACE_DIR=./traces
TRACE_MAX_CHARS=5000
